executable     = run_mesh_cell.sh
# cls: class to run (default SolveP2MeshCell); set it with -a "cls=..." or a
# DAG VARS line (a plain assignment here would override VARS)
clsfile        = $(cls:SolveP2MeshCell)
arguments      = $Fn(clsfile).class
transfer_input_files = $(clsfile).class
output         = logs/mesh_cell.$(ClusterId).out
error          = logs/mesh_cell.$(ClusterId).err
log            = logs/mesh_cell.$(ClusterId).log
request_cpus   = 8
request_memory = 24 GB
+JobFlavour    = "workday"
requirements   = (OpSysAndVer =?= "AlmaLinux9")
queue
