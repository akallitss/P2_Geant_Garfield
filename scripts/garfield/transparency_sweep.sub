# HTCondor: mesh transparency vs drift field (h2mm cell, one COMSOL solve per
# field from scripts/comsol/make_sweep.sh), for the literature comparison.
#   condor_submit scripts/garfield/transparency_sweep.sub
executable     = scripts/garfield/run_transparency.sh
cells          = /eos/user/a/akallits/p2_sim/comsol/p2_sps/h2mm_sweep
gases          = /eos/user/a/akallits/p2_sim/gas_tables
outdir         = /eos/user/a/akallits/p2_sim/transparency/sweep
output         = condor_transp/sweep_E$(E)_$(gas).out
error          = condor_transp/sweep_E$(E)_$(gas).err
log            = condor_transp/sweep.log
request_memory = 8 GB
+JobFlavour    = "workday"
arguments      = transp $(cells)/E$(E) $(gases)/$(gas).gas $(outdir)/E$(E)_$(gas) 3000 $(Process)
queue E, gas from (
  150 ArIso
  300 ArIso
  450 ArIso
  625 ArIso
  900 ArIso
  1250 ArIso
  1800 ArIso
  2500 ArIso
  150 ArIso9010
  300 ArIso9010
  450 ArIso9010
  625 ArIso9010
  900 ArIso9010
  1250 ArIso9010
  1800 ArIso9010
  2500 ArIso9010
  150 NeIso
  300 NeIso
  450 NeIso
  625 NeIso
  900 NeIso
  1250 NeIso
  1800 NeIso
  2500 NeIso
  150 ArCO2Iso9352
  300 ArCO2Iso9352
  450 ArCO2Iso9352
  625 ArCO2Iso9352
  900 ArCO2Iso9352
  1250 ArCO2Iso9352
  1800 ArCO2Iso9352
  2500 ArCO2Iso9352
  150 ArCO2_8515
  300 ArCO2_8515
  450 ArCO2_8515
  625 ArCO2_8515
  900 ArCO2_8515
  1250 ArCO2_8515
  1800 ArCO2_8515
  2500 ArCO2_8515
  3500 ArIso
  4500 ArIso
  6000 ArIso
  3500 ArCO2_8515
  4500 ArCO2_8515
  6000 ArCO2_8515
)
